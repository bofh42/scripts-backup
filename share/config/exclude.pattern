# no */tmp or */temp dir anywhere in the filesystem
*/tmp/
*/temp/

/dev
/media
/proc
/run
/srv
/sys
/tmp

# less from /var
/var/cache/apt
/var/cache/borg
/var/cache/dnf
/var/cache/cups
/var/cache/fwupd
/var/cache/lpd
/var/cache/man
/var/cache/mock
/var/cache/PackageKit
/var/cache/powertop
/var/cache/private
/var/cache/restic
/var/cache/rustic
/var/cache/swcatalog
/var/cache/yum
/var/lib/clamav
/var/lib/mock
/var/lock
/var/log/lastlog
/var/run
/var/spool/postfix
/var/tmp

# monitoring spool, cache
*/cache/naemon/
*/cache/nagios/
*/cache/thruk/
*/spool/naemon/
*/spool/nagios/
*/spool/nagflux/

# no backup of container images or cache
/var/lib/containers/cache/
/var/lib/containers/storage/overlay*/
/home/*/.local/share/containers/storage/overlay*/
/home/*/.local/share/containers/cache/

# no backup of flatpak
/var/lib/flatpak/
/home/*/.local/share/flatpak/

# no $HOME/.cache content or Trash
/root/.cache/
/root/.local/share/Trash/
/home/*/.cache/
/home/*/.local/share/Trash/

# exclude vscode-server
/root/.vscode-server
/home/*/.vscode-server

# exclude intellij and extensions
/home/*/.gradle
/home/*/.jdks
/home/*/.java

# other waste of backup space
/home/*/.cargo
/home/*/go
/home/*/.npm
/home/*/.platformio
# no AMD ROCm software
/opt/rocm*
# rpmbuild
/home/*/rpmbuild
# rpmbuild 42 config
/home/*/oci/build/rpm*build
